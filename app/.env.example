# Skopiuj do .env i uzupełnij: cp .env.example .env
# Copy to .env and fill in. Docker Compose reads this file (compose.yaml), and so does `npm start`.
# Every variable is optional; the defaults below are what the app uses when it is not set.

# --- Docker Compose ---

# Port na hoście (tylko 127.0.0.1). Ten sam port musi znać kiosk i agent ekranu:
# kiosk/install.sh zapisuje go w /etc/kiosk/kiosk.conf (KIOSK_PORT).
# Host port, bound to 127.0.0.1 only. Keep it equal to KIOSK_PORT in /etc/kiosk/kiosk.conf.
HOST_PORT=3000

# --- Dostęp / access ---

# Loginy (e-maile, po przecinku) z dostępem do /admin – z Tailscale albo z nagłówka proxy (AUTH_MODE=proxy).
# Puste = każdy zalogowany użytkownik. W trybie password panel ma każdy, kto zna hasło.
# Logins (comma-separated) allowed into /admin, from Tailscale or the proxy header. Empty = any signed-in user.
ADMIN_LOGINS=

# Tylko do lokalnego developmentu: 1 wpuszcza do /admin (i /api) bez logowania. Nigdy na kiosku.
# Local development only: 1 opens /admin (and /api) without sign-in. Never set this on the kiosk.
# ADMIN_DEV=1

# Adresy, z których formularze panelu są przyjmowane, choć różnią się od adresu aplikacji
# (CSRF). Czytane przy starcie, nie przy budowaniu. Domyślnie w compose: http://localhost:HOST_PORT,
# poza Dockerem (puste): http://localhost:PORT i http://127.0.0.1:PORT.
# Extra origins accepted for form posts (CSRF), read at startup. Empty = http://localhost:PORT and
# http://127.0.0.1:PORT (compose: http://localhost:HOST_PORT). The tailnet address usually
# works without it, add it here if /admin forms answer 403.
# TRUSTED_ORIGINS=http://localhost:3000,https://kalendarz.your-tailnet.ts.net

# --- Logowanie i API / sign-in and API (opis: README → Bezpieczeństwo / Security) ---

# Tryb logowania / sign-in mode:
#   tailscale – domyślny: telefony i panel przez `tailscale serve` (nagłówek Tailscale-User-Login).
#   proxy     – reverse proxy z logowaniem (Authelia, Authentik, Caddy forward_auth…) podaje login w nagłówku.
#   password  – jedno hasło domowe, strona /login, sesja w ciasteczku.
# Kiosk na tym komputerze (http://localhost:PORT) w każdym trybie działa bez logowania.
# The kiosk on this computer works without sign-in in every mode.
# AUTH_MODE=tailscale

# proxy: nazwa nagłówka z loginem (domyślnie Remote-User). Login header set by your proxy.
# AUTH_PROXY_HEADER=Remote-User

# Adresy pośredników, którym wierzymy (nagłówek Tailscale albo proxy, X-Forwarded-For). Adresy i CIDR.
# Domyślnie localhost, a w obrazie Dockera także sieci Dockera (LOCAL_NETS w Dockerfile: 127.0.0.0/8,::1,172.16.0.0/12).
# Nagłówek loginu z innego adresu jest ignorowany.
# Proxies whose login headers are trusted (IPs or CIDRs). Default: localhost; in the Docker image also the Docker networks.
# TRUSTED_PROXIES=127.0.0.0/8,::1

# Skąd przychodzi kiosk (Chromium na tym samym komputerze; w Dockerze – brama sieci Dockera).
# Kiosk = żądanie z tych adresów, z Host: localhost i bez nagłówków proxy (X-Forwarded-For itp.).
# Where the kiosk browser connects from. Default as TRUSTED_PROXIES.
# KIOSK_IPS=127.0.0.0/8,::1
# tailscale: sprawdzanie loginu z `tailscale serve` w tailscaled (LocalAPI whois, gniazdo
# /var/run/tailscale/tailscaled.sock – w Dockerze trzeba je zamontować, patrz compose.yaml).
# auto = gdy gniazdo jest dostępne, 1 = zawsze (bez gniazda loginy Tailscale są odrzucane), 0 = sam nagłówek.
# tailscale mode: verify the login header via tailscaled's LocalAPI whois. auto | 1 | 0.
# TAILSCALE_WHOIS=auto
# TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
# 0 = bez wyjątku dla kiosku (serwer bez ekranu: logowanie wszędzie). 0 = no kiosk exception.
# KIOSK_LOCAL=1

# password: skrót hasła z `node server/hash-password.js` (w Dockerze:
# `docker compose run --rm kalendarz node server/hash-password.js`). Puste = hasło ustawia się na /login
# kodem z ekranu kiosku (przytrzymaj zegar 2 s) albo z logów serwera, potem zmiana w panelu → Dostęp.
# Password hash for password mode. Empty = set it on /login with the code shown on the kiosk / in the logs.
# AUTH_PASSWORD_HASH=scrypt:32768:8:1:…

# Sekret podpisu ciasteczek (min. 32 znaki). Puste = losowy, zapisany w bazie (tabela secrets).
# Cookie signing secret (32+ chars). Empty = random, stored in the database.
# SESSION_SECRET=
# Długość sesji w dniach / session length in days.
# SESSION_DAYS=30
# Flaga Secure ciasteczka: auto (https z Origin/X-Forwarded-Proto), 1 = zawsze, 0 = nigdy.
# COOKIE_SECURE=auto

# Token dla skryptów i Home Assistanta: `Authorization: Bearer <API_TOKEN>` na /api/*. Min. 24 znaki,
# np. `openssl rand -hex 32`. Puste = /api tylko dla kiosku i zalogowanych.
# Token for scripts (Authorization: Bearer …) on /api/*. 24+ characters. Empty = no token access.
# API_TOKEN=

# --- Google Calendar ---

# Publiczny adres panelu, z którego powstaje adres powrotu OAuth (PUBLIC_ORIGIN + /admin/google/callback).
# Puste = adres, pod którym otwarto panel. Panel pokazuje gotowy adres w sekcji Google.
# Ten sam adres kiosk pokazuje jako kod QR w swoich ustawieniach (przytrzymaj zegar).
# Public origin for the OAuth redirect URI. Empty = the origin the panel was opened from.
# PUBLIC_ORIGIN=https://kalendarz.your-tailnet.ts.net

# Pełny adres powrotu OAuth, jeśli musi być inny niż PUBLIC_ORIGIN + /admin/google/callback.
# Full OAuth redirect URI override; wins over PUBLIC_ORIGIN.
# GOOGLE_REDIRECT_URI=

# --- Tryb demo / demo mode (opis: docs/demo.md) ---

# 1 = fikcyjna rodzina z całym tygodniem, wszystkie moduły, atrapy pogody, odjazdów i Home Assistanta
# (bez sieci). Własna baza w data/demo/ – prawdziwej bazy nie dotyka. Zmiany znikają przy starcie i co noc.
# Google, Bring!, Home Assistant, kopie, przywracanie i dostęp są w panelu tylko do podglądu. PIN kiosku: 1234.
# 1 = a made-up family with a whole week, all modules, fake weather/departures/Home Assistant (no network).
# Separate database in data/demo/; reset on start and nightly. Integrations, backups and access are view-only.
# DEMO=1
# Język i rodzina demo: pl (Poznań), de (Hanower), en (Hanower, po angielsku). Demo language and family.
# DEMO_LANG=pl
# Motyw demo (papier, noc, kontrast, drewno, fiord); domyślnie papier. Demo theme.
# DEMO_THEME=papier
# Godzina codziennego resetu (HH:MM, czas regionu) albo off – tylko przy starcie. Nightly reset time or off.
# DEMO_RESET=03:45

# --- System ---

# DNS kontenera (compose.yaml). Domyślnie 1.1.1.1 i 9.9.9.9 – działają także, gdy Tailscale przejmie DNS hosta,
# ale nie znają nazw z sieci domowej. Żeby panel rozwiązywał nazwy z LAN (np. nas.fritz.box), wpisz IP routera
# w DNS1. Nazw mDNS (*.local) kontener nie rozwiąże – użyj adresu IP albo extra_hosts w compose.yaml.
# Container DNS. Defaults survive Tailscale MagicDNS but don't know LAN names; set DNS1 to your router's IP
# for LAN names. mDNS (*.local) never resolves inside the container – use IP addresses or extra_hosts.
# DNS1=1.1.1.1
# DNS2=9.9.9.9

# Strefa czasowa procesu – tylko znaczniki czasu w logach. Dni, przypomnienia i godzina kopii zapasowych
# liczone są w strefie z regionu (panel → Region / kreator), niezależnie od TZ.
# Process time zone – log timestamps only. Days, reminders and the backup time follow the region set in the panel.
TZ=Europe/Berlin

# --- Poza Dockerem / outside Docker (`npm start`, `npm run dev`) ---
# W kontenerze są ustawione w Dockerfile; zmieniaj je tylko przy uruchamianiu bez Dockera.
# Set by the Dockerfile inside the container; only change them when running without Docker.

# Plik bazy SQLite; kopie zapasowe trafiają do backups/ obok niego. SQLite file (backups go next to it).
# DATABASE_PATH=data/kalendarz.db
# Domyślny folder kopii (miejsce „Na tym urządzeniu” i kopie „przed przywróceniem”); puste = backups/ obok bazy.
# Kolejne miejsca (NAS, WebDAV/Nextcloud) ustawia się w panelu → Kopie zapasowe, opis: docs/backup.md.
# Default backup folder; empty = backups/ next to the database. More targets are set in the panel.
# BACKUP_DIR=/backup
# Katalog migracji Drizzle. Drizzle migrations folder.
# MIGRATIONS_PATH=drizzle
# Adres i port serwera. Domyślnie tylko 127.0.0.1 (w Dockerze 0.0.0.0 z Dockerfile, port i tak tylko na 127.0.0.1 hosta).
# HOST=0.0.0.0 wystawia aplikację w sieci lokalnej: w trybie tailscale strony kiosku i telefonu są wtedy dla każdego w LAN.
# Server bind address and port. Default 127.0.0.1 only; HOST=0.0.0.0 exposes the app to your LAN.
# HOST=127.0.0.1
# PORT=3000
# 1 = świeża baza bez kreatora pierwszego uruchomienia, z danymi przykładowymi (testy, development).
# 1 = fresh database without the first-run wizard, with example data (tests, development).
# SKIP_SETUP=1
# Adres wyszukiwarki miejscowości w kreatorze (zgodny z Open-Meteo Geocoding API). Town search for the wizard.
# GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# Subskrypcje kalendarzy iCal (panel → Kalendarze) pobierają tylko z publicznego internetu. 1 = także adresy
# w sieci domowej / Tailscale (np. Nextcloud na NAS-ie). Opis: docs/calendars.md.
# iCal subscriptions fetch from the public internet only; 1 = also home network / Tailscale addresses.
# ICAL_ALLOW_PRIVATE=1
